# NECT Exam — Apache routing rules
Options -Indexes
RewriteEngine On
RewriteBase /

# Correct MIME types
AddType application/javascript .js .mjs
AddType text/css .css

# Pass Authorization header through to PHP (required on cPanel)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route API / auth / upload / health requests to api/api.php
RewriteRule ^api/(.*)$    api/api.php [QSA,L]
RewriteRule ^auth/(.*)$   api/api.php [QSA,L]
RewriteRule ^upload$      api/api.php [QSA,L]
RewriteRule ^health$      api/api.php [QSA,L]

# SPA fallback
RewriteRule ^ /index.html [L]
